# ==============================================================================
# DhanushApp Backend Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_USER=<db_username>
DB_PASSWORD=<db_password>

# Security & JWT Configuration
JWT_SECRET=replace-with-a-secure-random-32-char-string
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# AES-256 Vault Encryption Key (Base64 of 32 bytes)
VAULT_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Frontend & CORS
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Uploads Fallback
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080/api

# Email Service
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@dhanushapp.local
LOG_RESET_LINKS=true

